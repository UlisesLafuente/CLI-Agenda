@startuml CLI-Agenda-Architecture

!theme plain

skinparam packageStyle rectangle
skinparam backgroundColor #f5f5f5

' ==================== PACKAGES ====================

package "com.itacademy.cliagenda.application" {
    class AgendaApp {
        + main(args: String[])
    }
    class AppMenu {
        + playMenu()
    }
    class ComponentFactory <<service locator>> {
        + getInstance(): ComponentFactory
        + getEventService(): EventService
        + getTaskService(): TaskService
        + getNotesService(): NotesService
    }
}

package "com.itacademy.cliagenda.common.exception" #e0e0e0 {
    class EntityNotFoundException {
        + EntityNotFoundException(entityName, entityId)
        + getEntityName(): String
        + getEntityId(): Object
    }
    class ValidationException {
        + ValidationException(message)
    }
    class DatabaseException {
        + DatabaseException(message, cause)
    }
}

package "com.itacademy.cliagenda.common.formatter" #e0e0e0 {
    class EventFormatter {
        + formatList(events: List<Event>): String
        + formatDetail(event: Event): String
    }
    class TaskFormatter {
        + formatList(tasks: List<Task>): String
        + formatDetail(task: Task): String
    }
    class NoteFormatter {
        + formatList(notes: List<Note>): String
        + formatDetail(note: Note): String
    }
}

package "com.itacademy.cliagenda.common.validator" #e0e0e0 {
    class TaskValidator {
        + validateBody(body: String): void
        + validateEventFk(eventFk: Integer): void
    }
    class NoteValidator {
        + validateBody(body: String): void
        + validateTaskFk(taskFk: Integer): void
    }
    class EventValidator {
        + validateTitle(title: String): void
        + validateDescription(description: String): void
    }
}

package "com.itacademy.cliagenda.infrastructure.config" #fce4ec {
    class ConfigLoader {
        + getUrl(): String
        + getUsername(): String
        + getPassword(): String
    }
}

package "com.itacademy.cliagenda.event" #fff3e0 {
    interface IEventRepository {
        + findAll(): List<Event>
        + findById(id: int): Event
        + save(event: Event): int (generated ID)
        + update(event: Event)
        + delete(id: int)
    }
    class EventRepository implements IEventRepository
    class Event {
        - id: int
        - title: String
        - description: String
        - dateTimeEvent: LocalDateTime
        - recurring: boolean
        - annualRecurring: boolean
        - recurrenceInterval: int
        + changeTitle(title: String): void <<throws ValidationException>>
        + changeDescription(desc: String): void <<throws ValidationException>>
    }
    class CreateEventRequest {
        + title: String
        + description: String
        + dateTimeEvent: LocalDateTime
        + recurring: boolean
        + annualRecurring: boolean
        + recurrenceInterval: int
    }
    class UpdateEventRequest {
        + title: String
        + description: String
        + dateTimeEvent: LocalDateTime
        + recurring: Boolean
        + annualRecurring: Boolean
        + recurrenceInterval: Integer
    }
    class EventService {
        - repo: IEventRepository
        + createEvent(...): Event
        + getAllEvents(): List<Event>
        + findEventById(id: int): Event
        + deleteEventById(id: int)
        + updateEvent(event: Event)
        + getNextRecurrencies(event: Event): List<LocalDateTime>
        - eventExists(id: int): boolean
    }
    class EventCli {
        - eventService: EventService
        - taskService: TaskService
        - formatter: EventFormatter
        + showMenu()
    }
}

package "com.itacademy.cliagenda.task" #e8f5e8 {
    interface ITaskRepository {
        + findAll(): List<Task>
        + findById(id: int): Task
        + save(task: Task): int (generated ID)
        + update(task: Task)
        + delete(id: int)
        + findByEventId(eventId: int): List<Task>
        + findByCompleted(completed: boolean): List<Task>
    }
    class TaskRepository implements ITaskRepository
    class Task {
        - id: int
        - body: String
        - event_fk: Integer (nullable)
        - completed: boolean
        + changeBody(body: String): void <<throws ValidationException>>
        + setEvent_fk(eventFk: Integer): void <<throws ValidationException>>
    }
    class CreateTaskRequest {
        + body: String
        + eventId: Integer
    }
    class UpdateTaskRequest {
        + body: String
        + eventId: Integer
        + completed: Boolean
    }
    class TaskService {
        - repo: ITaskRepository
        - notesService: NotesService
        - eventService: EventService
        + createTask(body: String): Task
        + createTask(body: String, eventFk: int): Task
        + getAllTasks(): List<Task>
        + findTaskById(id: int): Task
        + deleteTaskById(id: int)
        + updateTask(task: Task)
        + getTasksByCompleted(completed: boolean): List<Task>
        + markTaskCompleted(id: int, completed: boolean)
        + getTasksByEventId(eventId: int): List<Task>
        + getNotesForTask(taskId: int): List<Note>
        - taskExists(id: int): boolean
        - getAvailableEventIds(): String
    }
    class TaskCli {
        - service: TaskService
        - formatter: TaskFormatter
        + showMenu()
    }
}

package "com.itacademy.cliagenda.note" #e3f2fd {
    interface INotesRepository {
        + findAll(): List<Note>
        + findById(id: int): Note
        + save(note: Note): int (generated ID)
        + update(note: Note)
        + delete(id: int)
        + findByTaskId(taskId: int): List<Note>
    }
    class NotesRepository implements INotesRepository
    class Note {
        - id: int
        - body: String
        - task_fk: Integer (nullable)
        + changeBody(body: String): void <<throws ValidationException>>
        + setTask_fk(taskFk: Integer): void <<throws ValidationException>>
    }
    class CreateNoteRequest {
        + body: String
        + taskId: Integer
    }
    class UpdateNoteRequest {
        + body: String
        + taskId: Integer
    }
    class NotesService {
        - repo: INotesRepository
        + createNote(body: String): Note
        + createNote(body: String, taskId: int): Note
        + getAllNotes(): List<Note>
        + findNoteById(id: int): Note
        + deleteNoteById(id: int)
        + updateNote(note: Note)
        + getNotesByTaskId(taskId: int): List<Note>
    }
    class NoteCli {
        - notesService: NotesService
        - taskService: TaskService
        - formatter: NoteFormatter
        + showMenu()
    }
}

package "com.itacademy.cliagenda.infrastructure.sql" #fce4ec {
    class SqlConnection {
        - instance: SqlConnection
        + getInstance(): SqlConnection <<singleton>>
        + getConnection(): Connection
        + closeConnection()
    }
}

' ==================== RELATIONSHIPS ====================

' Application startup
AgendaApp --> ComponentFactory : uses
ComponentFactory --> EventService : creates
ComponentFactory --> TaskService : creates
ComponentFactory --> NotesService : creates

AppMenu --> ComponentFactory : gets services from
AppMenu --> NoteCli : uses
AppMenu --> TaskCli : uses
AppMenu --> EventCli : uses

' CLI uses Formatter
EventCli --> EventFormatter : uses
TaskCli --> TaskFormatter : uses
NoteCli --> NoteFormatter : uses

' Services use Validators
EventService --> EventValidator : uses
TaskService --> TaskValidator : uses
NotesService --> NoteValidator : uses

' Event flow
EventCli --> EventService : uses
EventService --> CreateEventRequest : validates with
EventService --> UpdateEventRequest : validates with
EventService --> IEventRepository : uses
EventRepository --> SqlConnection : uses for DB
EventService --> Event : creates/manages

' Task flow
TaskCli --> TaskService : uses
TaskService --> CreateTaskRequest : validates with
TaskService --> UpdateTaskRequest : validates with
TaskService --> ITaskRepository : uses
TaskRepository --> SqlConnection : uses for DB
TaskService --> Task : creates/manages

' Note flow
NoteCli --> NotesService : uses
NotesService --> CreateNoteRequest : validates with
NotesService --> UpdateNoteRequest : validates with
NotesService --> INotesRepository : uses
NotesRepository --> SqlConnection : uses for DB
NotesService --> Note : creates/manages

' Cross references
TaskService --> NotesService : optional
TaskService --> EventService : optional

' Infrastructure
SqlConnection --> ConfigLoader : uses for config

' Exception handling
IEventRepository --> EntityNotFoundException : throws
ITaskRepository --> EntityNotFoundException : throws
INotesRepository --> EntityNotFoundException : throws

IEventRepository --> DatabaseException : throws
ITaskRepository --> DatabaseException : throws
INotesRepository --> DatabaseException : throws

Event --> ValidationException : throws
Task --> ValidationException : throws
Note --> ValidationException : throws

' Singleton marker
SqlConnection .. SqlConnection : <<singleton>>
ComponentFactory .. ComponentFactory : <<singleton>>

@enduml