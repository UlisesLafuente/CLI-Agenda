@startuml CLI-Agenda-Architecture

!theme plain

skinparam packageStyle rectangle
skinparam backgroundColor #f5f5f5

' ==================== PACKAGES ====================

package "com.itacademy.cliagenda.application" {
    class AgendaApp {
        + main(args: String[])
    }
    class AppMenu {
        + playMenu()
    }
}

package "com.itacademy.cliagenda.common.exception" #e0e0e0 {
    class EntityNotFoundException {
        + EntityNotFoundException(entityName, entityId)
        + getEntityName(): String
        + getEntityId(): Object
    }
    class ValidationException {
        + ValidationException(message)
    }
    class DatabaseException {
        + DatabaseException(message, cause)
    }
}

package "com.itacademy.cliagenda.event" #fff3e0 {
    interface IEventRepository {
        + findAll(): List<Event>
        + findById(id: int): Event
        + save(event: Event)
        + update(event: Event)
        + delete(id: int)
    }
    class EventRepository implements IEventRepository
    class Event {
        - id: int
        - title: String
        - description: String
        - dateTimeEvent: LocalDateTime
        - recurring: boolean
        - annualRecurring: boolean
        - recurrenceInterval: int
    }
    class EventService {
        - repo: IEventRepository
        + createEvent(...): Event
        + getAllEvents(): List<Event>
        + findEventById(id: int): Event
        + deleteEventById(id: int)
        + updateEvent(event: Event)
        + getNextRecurrencies(event: Event): List<LocalDateTime>
        + formatEventList(events: List<Event>): String
        + formatEventDetail(event: Event): String
    }
    class EventCli {
        - eventService: EventService
        - taskService: TaskService
        + showMenu()
    }
}

package "com.itacademy.cliagenda.task" #e8f5e8 {
    interface ITaskRepository {
        + findAll(): List<Task>
        + findById(id: int): Task
        + save(task: Task)
        + update(task: Task)
        + delete(id: int)
        + findByEventId(eventId: int): List<Task>
        + findByCompleted(completed: boolean): List<Task>
    }
    class TaskRepository implements ITaskRepository
    class Task {
        - id: int
        - body: String
        - event_fk: int
        - completed: boolean
    }
    class TaskService {
        - repo: ITaskRepository
        - notesService: NotesService
        - eventService: EventService
        + createTask(body: String): Task
        + createTask(body: String, event: Event): Task
        + getAllTasks(): List<Task>
        + findTaskById(id: int): Task
        + deleteTaskById(id: int)
        + updateTask(task: Task)
        + getTasksByCompleted(completed: boolean): List<Task>
        + markTaskCompleted(id: int, completed: boolean)
        + getTasksByEventId(eventId: int): List<Task>
        + formatTaskList(tasks: List<Task>): String
        + formatTaskDetail(task: Task): String
    }
    class TaskCli {
        - service: TaskService
        + showMenu()
    }
}

package "com.itacademy.cliagenda.note" #e3f2fd {
    interface INotesRepository {
        + findAll(): List<Note>
        + findById(id: int): Note
        + save(note: Note)
        + update(note: Note)
        + delete(id: int)
        + findByTaskId(taskId: int): List<Note>
    }
    class NotesRepository implements INotesRepository
    class Note {
        - id: int
        - body: String
        - task_fk: int
    }
    class NotesService {
        - repo: INotesRepository
        + createNote(body: String): Note
        + createNote(body: String, task: Task): Note
        + getAllNotes(): List<Note>
        + findNoteById(id: int): Note
        + deleteNoteById(id: int)
        + updateNote(note: Note)
        + getNotesByTaskId(taskId: int): List<Note>
        + formatNoteList(notes: List<Note>): String
        + formatNoteDetail(note: Note): String
    }
    class NoteCli {
        - notesService: NotesService
        - taskService: TaskService
        + showMenu()
    }
}

package "com.itacademy.cliagenda.infrastructure.sql" #fce4ec {
    class SqlConnection {
        - instance: SqlConnection
        + getInstance(): SqlConnection <<singleton>>
        + getConnection(): Connection
        + closeConnection()
    }
}

' ==================== RELATIONSHIPS ====================

AgendaApp --> AppMenu : creates
AppMenu --> NoteCli : uses
AppMenu --> TaskCli : uses
AppMenu --> EventCli : uses

' Event flow
EventCli --> EventService : uses
EventService --> IEventRepository : uses
IEventRepository --> SqlConnection : uses for DB
EventService --> Event : creates/manages

' Task flow
TaskCli --> TaskService : uses
TaskService --> ITaskRepository : uses
ITaskRepository --> SqlConnection : uses for DB
TaskService --> Task : creates/manages

' Note flow
NoteCli --> NotesService : uses
NotesService --> INotesRepository : uses
INotesRepository --> SqlConnection : uses for DB
NotesService --> Note : creates/manages

' Cross references
TaskService --> NotesService : optional
TaskService --> EventService : optional
Note --> Task : task_fk reference
Task --> Event : event_fk reference

' Exception handling
IEventRepository --> EntityNotFoundException : throws
ITaskRepository --> EntityNotFoundException : throws
INotesRepository --> EntityNotFoundException : throws

IEventRepository --> DatabaseException : throws
ITaskRepository --> DatabaseException : throws
INotesRepository --> DatabaseException : throws

EventService --> ValidationException : throws
TaskService --> ValidationException : throws
NotesService --> ValidationException : throws

' Singleton marker
SqlConnection .. SqlConnection : <<singleton>>

@enduml